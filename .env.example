# Database Configuration
POSTGRES_USER=ledgerlens
POSTGRES_PASSWORD=ledgerlens_secret
POSTGRES_DB=ledgerlens_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ledgerlens:ledgerlens_secret@localhost:5432/ledgerlens_db

# API Configuration
API_PORT=8000
ENVIRONMENT=development

# AI Providers Config
AI_PROVIDER=mock # Options: mock, groq, openai, gemini
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional LLM Model Overrides
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-1.5-flash
